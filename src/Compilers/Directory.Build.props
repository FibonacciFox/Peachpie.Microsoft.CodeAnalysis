<Project>
  <Import
    Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))"
    Condition="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\')) != ''" />

  <PropertyGroup Condition="
      '$(MSBuildProjectName)' == 'Microsoft.CodeAnalysis' or
      '$(MSBuildProjectName)' == 'Microsoft.CodeAnalysis.CSharp' or
      '$(MSBuildProjectName)' == 'Microsoft.CodeAnalysis.VisualBasic'">
    <!-- Must match Peachpie.Microsoft.CodeAnalysis so compiler IVT access to the renamed core assembly remains valid. -->
    <StrongNameKeyId>Open</StrongNameKeyId>
  </PropertyGroup>
</Project>
